diff --git a/socialjax/wrappers/reputation.py b/socialjax/wrappers/reputation.py
new file mode 100644
index 0000000..544ecb2
--- /dev/null
+++ b/socialjax/wrappers/reputation.py
@@ -0,0 +1,151 @@
+"""Reputation observation channel.
+
+For every agent i a discounted individual return is tracked
+
+    R_i(t) = lambda * R_i(t-1) + r_i(t)
+
+and its reputation is the gap to the mean of the other agents
+
+    rep_i(t) = R_i(t) - mean_{j != i} R_j(t).
+
+r_i(t) is ``info["individual_rewards"]``: the per-agent reward each env
+reports *before* converting it into a common / shaped reward. R is reset to
+zero when the episode ends (``done["__all__"]``).
+
+The reputation is appended to each agent's observation as one extra channel:
+the cell where agent j stands holds rep_j, every other cell is 0. The map is
+sliced and rotated exactly like the env's own egocentric view, so the value
+lands on the same cell as the agent it belongs to.
+
+Enable with ``socialjax.make(env_id, reputation=True, reputation_lambda=...)``
+or, from the training CLI, ``REPUTATION=True REPUTATION_LAMBDA=0.99``.
+"""
+from functools import partial
+from typing import Tuple
+
+import chex
+import jax
+import jax.numpy as jnp
+from flax import struct
+
+from socialjax.environments import spaces
+from socialjax.wrappers.baselines import JaxMARLWrapper
+
+
+@struct.dataclass
+class ReputationState:
+    env_state: chex.ArrayTree
+    discounted_returns: chex.Array  # R_i(t), shape (num_agents,)
+
+
+def compute_reputation(discounted_returns: chex.Array) -> chex.Array:
+    """rep_i = R_i - mean_{j != i} R_j."""
+    n = discounted_returns.shape[0]
+    others_mean = (jnp.sum(discounted_returns) - discounted_returns) / (n - 1)
+    return discounted_returns - others_mean
+
+
+class ReputationWrapper(JaxMARLWrapper):
+    """Tracks reputation and appends it to the observation as a last channel."""
+
+    # Envs whose egocentric window is centred on the agent rather than
+    # pushed forward in its facing direction.
+    _CENTRED_VIEW_ENVS = ("CoopMining",)
+
+    def __init__(self, env, reputation_lambda: float = 0.99):
+        super().__init__(env)
+        if not getattr(env, "cnn", True):
+            raise NotImplementedError("ReputationWrapper requires cnn=True observations.")
+        for attr in ("OBS_SIZE", "PADDING", "GRID_SIZE_ROW", "GRID_SIZE_COL"):
+            if not hasattr(env, attr):
+                raise NotImplementedError(
+                    f"ReputationWrapper does not support {type(env).__name__} "
+                    f"(missing egocentric grid attribute '{attr}')."
+                )
+        if env.num_agents < 2:
+            raise ValueError("Reputation needs at least two agents.")
+        self.reputation_lambda = reputation_lambda
+        self._centred_view = type(env).__name__ in self._CENTRED_VIEW_ENVS
+
+    def observation_space(self):
+        _, inner_shape = self._env.observation_space()
+        shape = (*inner_shape[:-1], inner_shape[-1] + 1)
+        return spaces.Box(low=-1e9, high=1e9, shape=shape, dtype=jnp.float32), shape
+
+    def render(self, state: ReputationState, *args, **kwargs):
+        return self._env.render(state.env_state, *args, **kwargs)
+
+    @partial(jax.jit, static_argnums=(0,))
+    def reset(self, key: chex.PRNGKey) -> Tuple[chex.Array, ReputationState]:
+        obs, env_state = self._env.reset(key)
+        discounted_returns = jnp.zeros((self._env.num_agents,), dtype=jnp.float32)
+        obs = self._add_channel(obs, env_state, compute_reputation(discounted_returns))
+        return obs, ReputationState(env_state, discounted_returns)
+
+    @partial(jax.jit, static_argnums=(0,))
+    def step(self, key: chex.PRNGKey, state: ReputationState, action, *args, **kwargs):
+        obs, env_state, reward, done, info = self._env.step(
+            key, state.env_state, action, *args, **kwargs
+        )
+        individual_rewards = jnp.reshape(info["individual_rewards"], (self._env.num_agents,))
+        discounted_returns = self.reputation_lambda * state.discounted_returns + individual_rewards
+        # Reputation is reported for the step that just happened, then R resets
+        # with the env so the next episode starts from zero.
+        reputation = compute_reputation(discounted_returns)
+        info["reputation"] = reputation
+        discounted_returns = jnp.where(done["__all__"], 0.0, discounted_returns)
+        # After an auto-reset the obs belongs to the new episode, where everyone is at 0.
+        obs_reputation = jnp.where(done["__all__"], 0.0, reputation)
+        obs = self._add_channel(obs, env_state, obs_reputation)
+        return obs, ReputationState(env_state, discounted_returns), reward, done, info
+
+    def _add_channel(self, obs: chex.Array, env_state, reputation: chex.Array) -> chex.Array:
+        channel = self.reputation_views(env_state.agent_locs, reputation)
+        return jnp.concatenate(
+            [obs.astype(jnp.float32), channel[..., None]], axis=-1
+        )
+
+    def reputation_views(self, agent_locs: chex.Array, values: chex.Array) -> chex.Array:
+        """Egocentric (num_agents, OBS_SIZE, OBS_SIZE) views of a map holding
+        values[j] at agent j's cell, using the env's slicing + rotation."""
+        env = self._env
+        rows = agent_locs[:, 0].astype(jnp.int32)
+        cols = agent_locs[:, 1].astype(jnp.int32)
+        value_map = jnp.zeros((env.GRID_SIZE_ROW, env.GRID_SIZE_COL), dtype=jnp.float32)
+        value_map = value_map.at[rows, cols].set(values.astype(jnp.float32))
+        return self.egocentric_views(value_map, agent_locs)
+
+    def egocentric_views(self, full_map: chex.Array, agent_locs: chex.Array, pad_value=0) -> chex.Array:
+        """Each agent's (OBS_SIZE, OBS_SIZE) window of a (GRID_SIZE_ROW, GRID_SIZE_COL) map."""
+        env = self._env
+        padded = jnp.pad(
+            full_map,
+            ((env.PADDING, env.PADDING), (env.PADDING, env.PADDING)),
+            constant_values=pad_value,
+        )
+
+        def view(agent_loc):
+            x, y = self._obs_point(agent_loc)
+            window = jax.lax.dynamic_slice(padded, (x, y), (env.OBS_SIZE, env.OBS_SIZE))
+            direction = agent_loc[2]
+            window = jnp.where(direction == 1, jnp.rot90(window, k=1, axes=(0, 1)), window)
+            window = jnp.where(direction == 2, jnp.rot90(window, k=2, axes=(0, 1)), window)
+            window = jnp.where(direction == 3, jnp.rot90(window, k=3, axes=(0, 1)), window)
+            return window
+
+        return jax.vmap(view)(agent_locs.astype(jnp.int32))
+
+    def _obs_point(self, agent_loc: chex.Array):
+        """Top-left corner of the agent's window in the padded map. Mirrors
+        ``_get_obs_point`` in the grid envs (and ``get_obs_point`` in coop_mining)."""
+        size, pad = self._env.OBS_SIZE, self._env.PADDING
+        x, y, direction = agent_loc[0], agent_loc[1], agent_loc[2]
+        x = x + pad - size // 2
+        y = y + pad - size // 2
+        if self._centred_view:
+            return x, y
+        x = jnp.where(direction == 0, x + size // 2 - 1, x)
+        y = jnp.where(direction == 1, y + size // 2 - 1, y)
+        x = jnp.where(direction == 2, x - size // 2 + 1, x)
+        y = jnp.where(direction == 3, y - size // 2 + 1, y)
+        return x, y
