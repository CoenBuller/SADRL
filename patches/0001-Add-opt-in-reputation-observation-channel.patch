+"""Standalone checks for socialjax.wrappers.reputation (no pytest).
+
+Run:
+  export PYTHONPATH=$PWD:$PYTHONPATH
+  JAX_PLATFORMS=cpu python tests/test_reputation.py
+"""
+
+import jax
+import jax.numpy as jnp
+import numpy as onp
+
+import socialjax
+from socialjax.wrappers.reputation import ReputationWrapper, compute_reputation
+
+ENVS = [
+    "coin_game",
+    "harvest_common_open",
+    "clean_up",
+    "coop_mining",
+    "territory_open",
+    "pd_arena",
+    "mushrooms",
+    "gift",
+]
+NUM_STEPS = 30
+# pd_arena's declared observation_space() assumes the 4 agents used by the training configs.
+ENV_KWARGS = {"pd_arena": {"num_agents": 4}}
+
+
+def run(name, fn):
+    fn()
+    print(f"ok: {name}")
+
+
+def random_actions(key, env):
+    return jax.random.randint(key, (env.num_agents,), 0, env.action_space().n)
+
+
+def test_formula():
+    R = jnp.array([4.0, 1.0, 1.0])
+    onp.testing.assert_allclose(compute_reputation(R), [3.0, -1.5, -1.5])
+    onp.testing.assert_allclose(compute_reputation(jnp.ones(5)), jnp.zeros(5))
+
+
+def rollout(env_id, shared_rewards, lam=0.9):
+    env = socialjax.make(env_id, reputation=True, reputation_lambda=lam,
+                         shared_rewards=shared_rewards, cnn=True, **ENV_KWARGS.get(env_id, {}))
+    key = jax.random.PRNGKey(0)
+    obs, state = env.reset(key)
+    steps = [(obs, state, None, None)]
+    for _ in range(NUM_STEPS):
+        key, k_act, k_step = jax.random.split(key, 3)
+        obs, state, reward, done, info = env.step(k_step, state, random_actions(k_act, env))
+        steps.append((obs, state, reward, info))
+    return env, steps
+
+
+def check_env(env_id):
+    for shared in (False, True):
+        lam = 0.9
+        env, steps = rollout(env_id, shared, lam)
+        inner_shape = env._env.observation_space()[1]
+
+        R = onp.zeros(env.num_agents)
+        for t, (obs, state, reward, info) in enumerate(steps):
+            # Shape: one extra channel, and observation_space() agrees.
+            assert obs.shape[-1] == inner_shape[-1] + 1, (env_id, obs.shape, inner_shape)
+            assert obs.shape[1:] == env.observation_space()[1], (env_id, obs.shape)
+
+            if info is not None:
+                r = onp.asarray(info["individual_rewards"]).reshape(-1)
+                assert r.shape == (env.num_agents,), (env_id, r.shape)
+                R = lam * R + r
+                onp.testing.assert_allclose(info["reputation"], compute_reputation(jnp.asarray(R)), rtol=1e-5, atol=1e-5)
+                onp.testing.assert_allclose(state.discounted_returns, R, rtol=1e-5, atol=1e-5)
+
+            # Placement: the reputation channel must equal the env's own view of
+            # a map that holds rep_j at agent j's cell.
+            rep = compute_reputation(state.discounted_returns)
+            expected = env.reputation_views(state.env_state.agent_locs, rep)
+            onp.testing.assert_allclose(obs[..., -1], expected, rtol=1e-5, atol=1e-5)
+
+        # Slicing/rotation agree with the env: run the env's own grid (non-empty
+        # cells, walls as padding) through the wrapper's view function and
+        # compare with the cells where the env's obs has any channel set. This
+        # checks offset and rotation for every agent and orientation.
+        rotations = set()
+        for obs, state, _, _ in steps:
+            es = state.env_state
+            # Ids above the last agent id (e.g. territory's ~1000 markers) fall
+            # outside the env's one-hot and never show up in the obs.
+            occupied = (es.grid != 0) & (es.grid <= int(jnp.max(env._agents)))
+            if hasattr(es, "occupant_grid"):  # coop_mining keeps agents in a separate grid
+                occupied = occupied | (es.occupant_grid > 0)
+            expected = onp.asarray(env.egocentric_views(occupied, es.agent_locs, pad_value=True))
+            actual = onp.asarray(obs[..., :-1]).any(axis=-1)
+            assert onp.array_equal(expected, actual), \
+                f"{env_id}: wrapper view does not line up with the env's obs"
+            rotations.update(onp.asarray(es.agent_locs[:, 2]).tolist())
+        print(f"   {env_id} (shared_rewards={shared}): obs {tuple(obs.shape)}, "
+              f"orientations seen {sorted(rotations)}")
+
+
+def test_default_unwrapped():
+    env = socialjax.make("pd_arena", cnn=True)
+    assert not isinstance(env, ReputationWrapper)
+
+
+if __name__ == "__main__":
+    run("formula", test_formula)
+    run("default is unwrapped", test_default_unwrapped)
+    for env_id in ENVS:
+        run(f"env {env_id}", lambda: check_env(env_id))
