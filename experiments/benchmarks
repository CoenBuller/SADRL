#!/bin/bash
environments=(pd_arena mushrooms gift cleanup)
algorithms=(IPPO MAPPO SVO)

for env in "${environments[@]}"; do
    for algo in "${algorithms[@]}"; do
        if [ "${algo}" = "IPPO" ] ; then 
            uv run python -m socialjax.algorithms.train --algo ${algo} --env ${env} reward=common
        else
            uv run python -m socialjax.algorithms.train --algo ${algo} --env ${env}
        fi
    done
done
