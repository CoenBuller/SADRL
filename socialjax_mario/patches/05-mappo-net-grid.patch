new file mode 100644
index 0000000..ed4f488
--- /dev/null
+++ b/tests/test_cc_credit.py
@@ -0,0 +1,84 @@
+"""CC-MAPPO credit formulas (research/cc_mappo/credit.py) on the round-6 worked examples, with the exact Q plugged in.
+
+Two agents, one step, actions {0: clean, 1: other}; each cleans with probability p. Run: python tests/test_cc_credit.py
+"""
+import os
+import sys
+
+os.environ.setdefault("JAX_PLATFORMS", "cpu")
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import jax.numpy as jnp
+import numpy as np
+
+from research.cc_mappo.credit import relative_others, baseline, credit, normalise_credit
+
+P = 0.5
+PROBS = jnp.array([P, 1 - P])
+COMPLEMENTS = jnp.array([[1.0, 0.0], [0.0, 0.0]])  # Q[a1, a2] = 1 only if both clean
+SUBSTITUTES = jnp.array([[1.0, 1.0], [1.0, 0.0]])  # Q = 1 if at least one cleans
+
+
+def agent1(Q, a1, a2, mode="coma"):
+    q = Q[:, a2]  # Q(s, (a', a2)) for every a' agent 1 could take
+    return float(credit(mode, q, PROBS, jnp.array(a1), Q[a1, a2]))
+
+
+def test_worked_examples():
+    assert np.isclose(agent1(COMPLEMENTS, 0, 0), 1 - P)          # complements, both cleaned: 1 - p each
+    assert np.isclose(agent1(SUBSTITUTES, 0, 0), 0.0)            # substitutes, both cleaned: 0 each
+    assert np.isclose(agent1(SUBSTITUTES, 0, 1), 1 - P)          # substitutes, only agent 1 cleaned: 1 - p
+    team_adv = COMPLEMENTS[0, 0] - jnp.sum(jnp.outer(PROBS, PROBS) * COMPLEMENTS)
+    assert np.isclose(float(team_adv), 1 - P ** 2)               # vs the team advantage 1 - p^2
+
+
+def test_null_player():
+    Q = jnp.array([[0.3, 0.9], [0.3, 0.9]])  # agent 1's action changes nothing
+    for a1 in (0, 1):
+        for a2 in (0, 1):
+            assert np.isclose(agent1(Q, a1, a2), 0.0)
+
+
+def test_qret_and_loo_with_exact_return():
+    # With G = Q(s, a) exactly, (b) and (c) give the same credit as (a); (c)'s V(s, a^-i) is the COMA baseline.
+    for Q in (COMPLEMENTS, SUBSTITUTES):
+        for a1 in (0, 1):
+            for a2 in (0, 1):
+                a = agent1(Q, a1, a2, "coma")
+                assert np.isclose(agent1(Q, a1, a2, "qret"), a)
+                v_loo = baseline(Q[:, a2], PROBS)[None]
+                assert np.isclose(float(credit("loo", v_loo, PROBS, jnp.array(a1), Q[a1, a2])), a)
+
+
+def test_zero_mean_under_the_policy():
+    rng = np.random.default_rng(0)
+    q = jnp.array(rng.normal(size=9))
+    probs = jnp.array(rng.dirichlet(np.ones(9)))
+    mean_credit = sum(float(probs[a]) * float(credit("coma", q, probs, jnp.array(a), 0.0)) for a in range(9))
+    assert abs(mean_credit) < 1e-6
+
+
+def test_relative_order():
+    joint = jnp.array([[10, 11, 12, 13]] * 4)
+    others = relative_others(joint, jnp.arange(4))
+    assert others.tolist() == [[11, 12, 13], [12, 13, 10], [13, 10, 11], [10, 11, 12]]
+
+
+def test_normalise_credit():
+    """team: centred on the credit's mean, scaled by std(hat A); self: the old round-7 normalisation (unit std)."""
+    adv = jnp.array([1.0, -1.0, 3.0, -3.0])
+    tiny = jnp.array([1e-4, -1e-4, 2e-4, 0.0])                 # an untrained critic: tiny, but systematic
+    team = normalise_credit(tiny, adv, "team")
+    assert np.isclose(float(team.mean()), 0.0, atol=1e-12)
+    assert float(jnp.abs(team).max()) < 1e-3                    # stays tiny next to the team advantage
+    own = normalise_credit(tiny, adv, "self")
+    assert np.isclose(float(own.std()), 1.0, atol=1e-3)         # the old way inflates it to unit size
+    same = normalise_credit(adv, adv, "team")
+    assert np.allclose(np.asarray(same), np.asarray(normalise_credit(adv, adv, "self")))  # equal when credit = hat A
+
+
+if __name__ == "__main__":
+    for name, fn in list(globals().items()):
+        if name.startswith("test_"):
+            fn()
+            print(name, "OK")
diff --git a/tests/test_cc_logging.py b/tests/test_cc_logging.py
new file mode 100644
index 0000000..27cbf40
--- /dev/null
+++ b/tests/test_cc_logging.py
@@ -0,0 +1,54 @@
+"""CC-MAPPO (2026-10-21): PPO diagnostics in the W&B log, as added to MAPPO by the [SADRL fix 2026-10-21].
+
+For each credit mode, 2 updates on a tiny config: approx_kl, clip_frac, entropy, value_mean and target_mean are logged
+and finite (the credit metrics are logged as before).
+
+Run: python tests/test_cc_logging.py   (CPU is fine; about a minute per mode)
+"""
+import math
+import os
+import sys
+
+os.environ.setdefault("JAX_PLATFORMS", "cpu")
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import jax
+import wandb
+from omegaconf import OmegaConf
+
+from research.cc_mappo import cc_mappo
+
+CFG_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "algorithms", "MAPPO", "config")
+KEYS = ("actor_loss", "value_loss", "credit_critic_loss", "entropy", "approx_kl", "clip_frac",
+        "value_mean", "target_mean", "credit_mean")
+
+
+def tiny_config(mode):
+    cfg = OmegaConf.merge(*(OmegaConf.load(os.path.join(CFG_DIR, f)) for f in
+                            ("mappo_base.yaml", "mappo_cnn_cleanup.yaml", "mappo_cnn_cc_cleanup.yaml")))
+    cfg = OmegaConf.to_container(cfg)
+    cfg.pop("defaults", None)
+    cfg.update(NUM_ENVS=2, NUM_STEPS=100, NUM_MINIBATCHES=2, TOTAL_TIMESTEPS=400, WANDB_MODE="disabled",
+               NETWORK_SIZE="full", CREDIT_MODE=mode)
+    return cfg
+
+
+def test_logged_keys():
+    real_log = wandb.log
+    for mode in ("coma", "qret", "loo", "local"):
+        logged = []
+        wandb.log = lambda m, *a, **k: logged.append(m)
+        try:
+            cc_mappo.make_train(tiny_config(mode))(jax.random.PRNGKey(0))
+        finally:
+            wandb.log = real_log
+        assert len(logged) == 2, (mode, len(logged))
+        for k in KEYS:
+            assert k in logged[-1], f"{mode}: {k} not logged"
+            assert math.isfinite(float(logged[-1][k])), f"{mode}: {k} = {logged[-1][k]}"
+        print(f"{mode}: OK", {k: round(float(logged[-1][k]), 4) for k in KEYS})
+
+
+if __name__ == "__main__":
+    wandb.init(mode="disabled")
+    test_logged_keys()
diff --git a/tests/test_ia_normalized_traces.py b/tests/test_ia_normalized_traces.py
new file mode 100644
index 0000000..dce10b4
--- /dev/null
+++ b/tests/test_ia_normalized_traces.py
@@ -0,0 +1,158 @@
+"""Standalone checks for the [SADRL fix 2026-10-18] IA options (no pytest).
+
+- inequity_aversion_normalize_trace: the penalty compares e_hat = (1 - gamma*lambda) * e instead of e, i.e.
+      u_i = r_i - alpha/(N-1) sum_j max(e_hat_j - e_hat_i, 0) - beta/(N-1) sum_j max(e_hat_i - e_hat_j, 0)
+  (equivalently: the plain formula with alpha, beta multiplied by (1 - gamma*lambda)).
+- inequity_aversion_observe_traces: agent i's obs gets N extra constant channels [e_hat_i, e_hat_(i+1), ...] (mod N).
+- IPPO's SVOLogWrapper logs returned_episode_original_returns next to returned_episode_returns.
+
+Run from the repo root:
+  JAX_PLATFORMS=cpu PYTHONPATH=$PWD python tests/test_ia_normalized_traces.py
+"""
+
+import jax
+import numpy as onp
+
+import socialjax
+from socialjax.wrappers.baselines import SVOLogWrapper
+
+ALPHA, BETA = 0.0, 1.4
+DECAY = 0.99 * 0.975
+BASE_CHANNELS = {"coin_game": 14, "clean_up": 19}
+AGENTS = {"coin_game": 2, "clean_up": 7}
+
+
+def hughes(r, e, alpha=ALPHA, beta=BETA):
+    """Reference eq. 3 in plain numpy; r, e: [N]."""
+    n = len(r)
+    diff = e[None, :] - e[:, None]                    # [i, j] = e_j - e_i
+    dis = onp.maximum(diff, 0).sum(1)
+    adv = onp.maximum(-diff, 0).sum(1)
+    return r - (alpha * dis + beta * adv) / (n - 1)
+
+
+def run(name, fn):
+    fn()
+    print(f"ok: {name}")
+
+
+def make(name, **kw):
+    return socialjax.make(name, num_agents=AGENTS[name], shared_rewards=False, inequity_aversion=True,
+                          enable_smooth_rewards=True, inequity_aversion_alpha=ALPHA, inequity_aversion_beta=BETA,
+                          inequity_aversion_smooth_decay=DECAY, **kw)
+
+
+def rollout(env, steps, seed=0):
+    """Random-action rollout; yields (obs, rew [N], info) per step. Stays inside the first episode."""
+    n = env.num_agents
+    key = jax.random.PRNGKey(seed)
+    key, k = jax.random.split(key)
+    obs, state = env.reset(k)
+    yield obs, None, None
+    step = jax.jit(env.step)
+    for _ in range(steps):
+        key, k_act, k_step = jax.random.split(key, 3)
+        acts = jax.random.randint(k_act, (n,), 0, env.action_space().n)
+        obs, state, rew, done, info = step(k_step, state, [acts[i] for i in range(n)])
+        yield obs, onp.asarray(rew, onp.float64).ravel(), info
+
+
+def test_defaults_unchanged():
+    """Flags off: obs keeps its old channel count."""
+    for name, c in BASE_CHANNELS.items():
+        env = make(name)
+        obs, _ = env.reset(jax.random.PRNGKey(0))
+        assert obs.shape[-1] == c == env.observation_space()[1][-1], (name, obs.shape)
+
+
+def test_normalized_and_observed(name, steps):
+    env = make(name, inequity_aversion_normalize_trace=True, inequity_aversion_observe_traces=True)
+    n, c = env.num_agents, BASE_CHANNELS[name]
+    assert env.observation_space()[1] == (11, 11, c + n), env.observation_space()
+    e = onp.zeros(n)
+    n_rewarded = n_gap = 0
+    for t, (obs, rew, info) in enumerate(rollout(env, steps)):
+        assert obs.shape == (n, 11, 11, c + n), obs.shape
+        if t > 0:
+            r = onp.asarray(info["original_rewards"], onp.float64).ravel()
+            e = DECAY * e + r
+            assert onp.allclose(onp.asarray(info["smooth_rewards"]).ravel(), e, atol=1e-4)   # state keeps the raw trace
+            e_hat = (1 - DECAY) * e
+            onp.testing.assert_allclose(rew, hughes(r, e_hat), rtol=1e-4, atol=1e-4)
+            # same thing as the plain formula with alpha, beta scaled by (1 - gamma*lambda)
+            onp.testing.assert_allclose(rew, hughes(r, e, ALPHA * (1 - DECAY), BETA * (1 - DECAY)), rtol=1e-4, atol=1e-4)
+            n_rewarded += bool(onp.any(r != 0))
+            n_gap += bool(onp.ptp(e) > 1e-6)
+        # trace channels: constant over the 11x11 view, agent i sees [e_hat_i, e_hat_(i+1), ...]
+        planes = onp.asarray(obs[..., c:])
+        assert onp.allclose(planes, planes[:, :1, :1, :]), "trace channels are not constant over the view"
+        e_hat = (1 - DECAY) * e
+        expect = onp.stack([onp.roll(e_hat, -i) for i in range(n)])
+        onp.testing.assert_allclose(planes[:, 0, 0, :], expect, rtol=1e-4, atol=1e-5)
+    assert n_rewarded > 0, f"{name}: nobody was rewarded; the rollout did not exercise the shaping"
+    print(f"   {name}: {n_rewarded}/{steps} rewarded steps, {n_gap} steps with unequal traces")
+
+
+def test_bad_flag_combinations():
+    for kw in (dict(enable_smooth_rewards=False), dict(shared_rewards=True)):
+        args = dict(num_agents=2, shared_rewards=False, inequity_aversion=True, enable_smooth_rewards=True,
+                    inequity_aversion_normalize_trace=True)
+        args.update(kw)
+        try:
+            socialjax.make("coin_game", **args)
+        except AssertionError:
+            continue
+        raise AssertionError(f"expected an assertion for {kw}")
+
+
+def test_svo_log_wrapper_logs_both_returns():
+    """With IA on, returned_episode_returns is the subjective return and returned_episode_original_returns the raw one."""
+    steps = 60
+    env = SVOLogWrapper(socialjax.make("coin_game", num_agents=2, num_inner_steps=steps, shared_rewards=False,
+                                       inequity_aversion=True, enable_smooth_rewards=True, inequity_aversion_alpha=ALPHA,
+                                       inequity_aversion_beta=BETA, inequity_aversion_normalize_trace=True))
+    key = jax.random.PRNGKey(3)
+    obs, state = env.reset(key)
+    step = jax.jit(env.step)
+    shaped = raw = onp.zeros(2)
+    for t in range(steps):
+        key, k_act, k_step = jax.random.split(key, 3)
+        acts = jax.random.randint(k_act, (2,), 0, env._env.action_space().n)
+        obs, state, rew, done, info = step(k_step, state, [acts[0], acts[1]])
+        shaped = shaped + onp.asarray(rew).ravel()
+        raw = raw + onp.asarray(info["original_rewards"]).ravel()
+    assert bool(done["__all__"]), "episode did not end"
+    onp.testing.assert_allclose(onp.asarray(info["returned_episode_returns"]), shaped, rtol=1e-4, atol=1e-4)
+    onp.testing.assert_allclose(onp.asarray(info["returned_episode_original_returns"]), raw, rtol=1e-4, atol=1e-4)
+    print(f"   subjective return {shaped}, raw return {raw}")
+
+
+def test_cleanup_with_given_traces():
+    """Random agents almost never eat in Clean Up (the river must be cleaned first), so feed it hand-made traces."""
+    env = make("clean_up", inequity_aversion_normalize_trace=True, inequity_aversion_observe_traces=True)
+    n, c = env.num_agents, BASE_CHANNELS["clean_up"]
+    rng = onp.random.default_rng(0)
+    e = rng.uniform(0, 30, n).astype(onp.float32)
+    r = (rng.uniform(size=n) < 0.3).astype(onp.float32) * n          # some agents eat (x N, as in the env)
+    u, _, _ = env.get_inequity_aversion_rewards_immediate(env._ia_traces(e.reshape(n, 1)), 0, None, ALPHA, BETA,
+                                                          immediate_rewards=r.reshape(n, 1))
+    onp.testing.assert_allclose(onp.asarray(u).ravel(), hughes(r, (1 - DECAY) * e), rtol=1e-4, atol=1e-4)
+    obs, state = env.reset(jax.random.PRNGKey(0))
+    assert obs.shape == (n, 11, 11, c + n) and env.observation_space()[1] == (11, 11, c + n)
+    state = state.replace(smooth_rewards=e.reshape(n, 1))
+    out = onp.asarray(env._append_ia_trace_channels(obs[..., :c], state))
+    onp.testing.assert_array_equal(out[..., :c], onp.asarray(obs[..., :c]))
+    expect = onp.stack([onp.roll((1 - DECAY) * e, -i) for i in range(n)])
+    onp.testing.assert_allclose(out[:, 5, 7, c:], expect, rtol=1e-5, atol=1e-6)
+    assert onp.allclose(out[..., c:], out[:, :1, :1, c:])
+    for _ in rollout(env, 5):                                          # and it steps
+        pass
+
+
+if __name__ == "__main__":
+    run("flags off: obs unchanged", test_defaults_unchanged)
+    run("Coins: normalised penalty + observed traces vs. hand computation",
+        lambda: test_normalized_and_observed("coin_game", 300))
+    run("Clean Up: normalised penalty + trace channels with given traces", test_cleanup_with_given_traces)
+    run("bad flag combinations raise", test_bad_flag_combinations)
+    run("SVOLogWrapper logs subjective and raw episode returns", test_svo_log_wrapper_logs_both_returns)
diff --git a/tests/test_inequity_aversion_fix.py b/tests/test_inequity_aversion_fix.py
new file mode 100644
index 0000000..7471a75
--- /dev/null
+++ b/tests/test_inequity_aversion_fix.py
@@ -0,0 +1,126 @@
+"""Standalone checks for the [SADRL fix 2026-10-12] inequity-aversion fixes (no pytest).
+
+Checks against Hughes et al. (2018), eq. 3-4:
+  e_j^t = gamma*lambda * e_j^{t-1} + r_j^t
+  u_i^t = r_i^t - alpha/(N-1) sum_j max(e_j - e_i, 0) - beta/(N-1) sum_j max(e_i - e_j, 0)
+
+Run from the repo root:
+  JAX_PLATFORMS=cpu PYTHONPATH=$PWD python tests/test_inequity_aversion_fix.py
+"""
+
+import jax
+import jax.numpy as jnp
+import numpy as onp
+
+import socialjax
+
+ALPHA, BETA = 5.0, 0.05
+
+
+def hughes(r, e, alpha=ALPHA, beta=BETA):
+    """Reference eq. 3 in plain numpy; r, e: [N]."""
+    n = len(r)
+    diff = e[None, :] - e[:, None]                    # [i, j] = e_j - e_i
+    dis = onp.maximum(diff, 0).sum(1)
+    adv = onp.maximum(-diff, 0).sum(1)
+    return r - (alpha * dis + beta * adv) / (n - 1)
+
+
+def run(name, fn):
+    fn()
+    print(f"ok: {name}")
+
+
+def test_function_level():
+    env = socialjax.make("clean_up", num_agents=7, shared_rewards=False, inequity_aversion=True,
+                         inequity_aversion_alpha=ALPHA, inequity_aversion_beta=BETA)
+    f = env.get_inequity_aversion_rewards_immediate
+
+    # Nobody rewarded: u = 0 (was -(alpha+beta)(N-1) = -30.3 for every agent).
+    u, _, _ = f(jnp.zeros((7, 1)), 0, None, ALPHA, BETA)
+    onp.testing.assert_allclose(onp.asarray(u).ravel(), 0.0)
+
+    # Immediate rewards (no smoothing): matches eq. 3 with e = r.
+    r = onp.array([0, 1, 0, 0, 2, 0, 0], onp.float32)
+    u, _, _ = f(jnp.asarray(r)[:, None], 0, None, ALPHA, BETA)
+    onp.testing.assert_allclose(onp.asarray(u).ravel(), hughes(r, r), rtol=1e-6)
+
+    # Smoothed: penalty from traces e, subtracted from the immediate reward r (was e_i - penalty).
+    e = onp.array([0.5, 1.2, 0, 0, 2.0, 0.1, 0], onp.float32)
+    u, _, _ = f(jnp.asarray(e)[:, None], 0, None, ALPHA, BETA, immediate_rewards=jnp.asarray(r)[:, None])
+    onp.testing.assert_allclose(onp.asarray(u).ravel(), hughes(r, e), rtol=1e-6)
+
+
+def test_coins_rollout_with_smoothing():
+    """Roll out Coins with smoothed IA and recompute every shaped reward by hand."""
+    decay = 0.99 * 0.975
+    env = socialjax.make("coin_game", num_agents=2, num_inner_steps=1000, shared_rewards=False,
+                         inequity_aversion=True, enable_smooth_rewards=True,
+                         inequity_aversion_alpha=ALPHA, inequity_aversion_beta=BETA,
+                         inequity_aversion_smooth_decay=decay)
+    assert env.inequity_aversion_smooth_decay == decay
+    key = jax.random.PRNGKey(0)
+    key, k = jax.random.split(key)
+    obs, state = env.reset(k)
+    step = jax.jit(env.step)
+    e = onp.zeros(2)
+    n_rewarded = n_zero = 0
+    for _ in range(300):                               # stays inside one episode (Coins zeroes the reward on the reset step)
+        key, k_act, k_step = jax.random.split(key, 3)
+        acts = jax.random.randint(k_act, (2,), 0, env.action_space().n)
+        obs, state, rew, done, info = step(k_step, state, [acts[0], acts[1]])
+        r = onp.asarray(info["original_rewards"]).ravel()
+        e = decay * e + r
+        assert onp.allclose(onp.asarray(info["smooth_rewards"]).ravel(), e, atol=1e-4), (info["smooth_rewards"], e)
+        shaped = onp.array([rew[a] for a in env.agents]).ravel()
+        onp.testing.assert_allclose(shaped, hughes(r, e), rtol=1e-5, atol=1e-5)
+        if onp.all(r == 0) and onp.all(onp.abs(e) < 1e-6):
+            n_zero += 1
+            assert onp.all(shaped == 0), shaped        # no -(alpha+beta)(N-1) penalty
+        if onp.any(r != 0):
+            n_rewarded += 1
+    assert n_rewarded > 0, "no coin was eaten; the rollout did not exercise the shaping"
+    print(f"   {n_rewarded} rewarded steps, {n_zero} steps with no reward and zero traces")
+
+
+def rollout_matches_hughes(name, smooth, steps=150):
+    """[SADRL fix 2026-10-12b] IA used to crash in gift/territory/coop_mining (flat rewards) and with
+    smoothing in harvest_open/territory (no State field); coop_mining never returned the shaped reward.
+    Roll out with random actions and check the *returned* reward against eq. 3-4 at every step."""
+    decay = 0.99 * 0.975
+    env = socialjax.make(name, shared_rewards=False, inequity_aversion=True, enable_smooth_rewards=smooth,
+                         inequity_aversion_alpha=ALPHA, inequity_aversion_beta=BETA)
+    n = env.num_agents
+    key = jax.random.PRNGKey(1)
+    key, k = jax.random.split(key)
+    obs, state = env.reset(k)
+    step = jax.jit(env.step)
+    e = onp.zeros(n)
+    n_rewarded = 0
+    for _ in range(steps):                             # far from the end of the episode
+        key, k_act, k_step = jax.random.split(key, 3)
+        acts = jax.random.randint(k_act, (n,), 0, env.action_space().n)
+        obs, state, rew, done, info = step(k_step, state, [acts[i] for i in range(n)])
+        r = onp.asarray(info["original_rewards"], onp.float64).ravel()
+        e = decay * e + r if smooth else r
+        if smooth:
+            assert onp.allclose(onp.asarray(info["smooth_rewards"]).ravel(), e, atol=1e-4)
+        returned = onp.asarray(rew, onp.float64).ravel()
+        onp.testing.assert_allclose(returned, hughes(r, e), rtol=1e-4, atol=1e-4)
+        n_rewarded += bool(onp.any(r != 0))
+    print(f"   {name}, smoothing={smooth}: {n_rewarded}/{steps} rewarded steps")
+
+
+def test_previously_broken_envs():
+    for name in ["gift", "territory_open", "coop_mining", "harvest_common_open"]:
+        for smooth in (False, True):
+            # random agents rarely mine in coop_mining, so roll out longer to get rewarded steps
+            rollout_matches_hughes(name, smooth, steps=900 if name == "coop_mining" else 150)
+
+
+if __name__ == "__main__":
+    run("function level (zero rewards, immediate, smoothed)", test_function_level)
+    run("Coins rollout with smoothed IA vs. hand computation", test_coins_rollout_with_smoothing)
+    run("gift / territory / coop_mining / harvest_open rollouts vs. hand computation",
+        test_previously_broken_envs)
+    print("all inequity-aversion checks passed")
